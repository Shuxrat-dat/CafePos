# Скопируйте в .env и заполните. Файл .env в git не попадает.
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.5
# Включайте только если сайт открывается по https
DJANGO_HTTPS=False

# PostgreSQL. Если не задано, используется SQLite (db.sqlite3)
# DJANGO_DB_NAME=cafepos
# DJANGO_DB_USER=cafepos
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432

# Демо-режим: отдельная база demo.sqlite3 для презентаций. В рабочей кассе не включать.
# CAFEPOS_DEMO=1
