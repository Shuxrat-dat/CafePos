msgstr "Avans"

msgid "Введите сумму больше нуля."
msgstr "Noldan katta summa kiriting."

msgid "Взять из кассы (изъятие в смене)"
msgstr "Kassadan olish (smenadan chiqim)"

msgid "Вид"
msgstr "Turi"

