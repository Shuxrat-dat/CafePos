msgstr "Pozitsiya oʻzgartirildi."

msgid "Блюдо уже на кухне. Убрать его может администратор."
msgstr "Taom allaqachon oshxonada. Uni faqat administrator olib tashlay oladi."

msgid "Позиция удалена."
msgstr "Pozitsiya oʻchirildi."

msgid "Заказ отправлен на кухню."
msgstr "Buyurtma oshxonaga yuborildi."

msgid "Готовые блюда отмечены поданными."
msgstr "Tayyor taomlar berilgan deb belgilandi."

