#, python-format
msgid "Заказ №%(n)s отправлен на кухню."
msgstr "Buyurtma №%(n)s oshxonaga yuborildi."

#, python-format
msgid "Статус заказа №%(n)s обновлён."
msgstr "Buyurtma №%(n)s holati yangilandi."

#, python-format
msgid "Заказ №%(n)s выдан."
msgstr "Buyurtma №%(n)s berildi."

msgid "Введите сумму числом."
msgstr "Summani son bilan kiriting."

msgid "Выберите вид скидки."
msgstr "Chegirma turini tanlang."

msgid "Введите размер скидки числом больше нуля."
msgstr "Chegirma miqdorini noldan katta son bilan kiriting."

msgid "Скидка не может быть больше 100%."
msgstr "Chegirma 100% dan oshmasligi kerak."

msgid "Скидка больше суммы заказа."
msgstr "Chegirma buyurtma summasidan katta."

msgid "Выберите способ оплаты."
msgstr "Toʻlov usulini tanlang."

msgid "Полученная сумма меньше итога."
msgstr "Olingan summa jamidan kam."

msgid "Укажите, сколько оплачено картой."
msgstr "Karta bilan qancha toʻlanganini kiriting."

msgid "Сумма по карте должна быть меньше итога. Для полной оплаты картой выберите «Карта»."
msgstr "Karta summasi jamidan kam boʻlishi kerak. Toʻliq karta toʻlovi uchun «Karta»ni tanlang."

msgid "Наличных меньше, чем нужно доплатить."
msgstr "Naqd pul qoʻshimcha toʻlanadigan summadan kam."

msgid "Заказ уже закрыт."
msgstr "Buyurtma allaqachon yopilgan."

msgid "Бронь снята."
msgstr "Bron bekor qilindi."

msgid "Укажите время в формате ЧЧ:ММ."
msgstr "Vaqtni SS:DD formatida kiriting."

msgid "Укажите, на чьё имя бронь."
msgstr "Bron kimning nomiga ekanini kiriting."

msgid "Стол забронирован."
msgstr "Stol bron qilindi."

#, python-format
msgid "«%(name)s» сейчас нет в продаже."
msgstr "«%(name)s» hozir sotuvda yoʻq."

